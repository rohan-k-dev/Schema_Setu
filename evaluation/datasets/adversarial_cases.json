    {"case_id": "A30", "category": "HUMAN_REVIEW", "kind": "review_unauthorized_resolve", "expect": "403 and case status unchanged", "attack": "§111 unauthorized resolution"},
    {"case_id": "A31", "category": "SECURITY", "kind": "static_secret_scan", "expect": "no API keys, tokens or reviewer secrets hard-coded in tracked source", "attack": "§113 secret leakage"},
    {"case_id": "A32", "category": "SECURITY", "kind": "huge_message", "length": 100000, "expect": "rejected with 422 before reaching the LLM", "attack": "§98 huge query"},
    {"case_id": "A33", "category": "SECURITY", "kind": "blank_message", "message": "     ", "expect": "no crash; no fabricated schemes", "attack": "§163 empty input"},
    {"case_id": "A34", "category": "SECURITY", "kind": "log_audit", "extraction": {"state": "Karnataka", "land_size_acres": 2, "primary_crop": "ragi", "annual_income": 187654, "has_aadhaar": true, "category": "SC"}, "expect": "logs do not contain the income value, category value or Aadhaar status", "attack": "§113 sensitive data in logs"},
    {"case_id": "A35", "category": "SECURITY", "kind": "network_audit", "extraction": {"state": "Karnataka", "land_size_acres": 2, "primary_crop": "ragi", "annual_income": 187654, "has_aadhaar": true, "category": "SC"}, "expect": "Tavily query and query-rewriter prompt contain no income, category or Aadhaar data", "attack": "§114 outbound data minimisation"},
    {"case_id": "A36", "category": "SECURITY", "kind": "duplicate_submission", "extraction": {"state": "Karnataka", "land_size_acres": 2, "primary_crop": "ragi", "occupation": "farmer"}, "expect": "same message twice in one session gives identical statuses, no conflict question", "attack": "§163 accidental duplicate submission"}
