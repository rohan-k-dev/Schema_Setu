  "label_method": "Each case defines a rule set and profile. Expected explanation facts were written by hand: the fields an explanation may mention (only fields that have rule evidence), the field it must NOT mention, the numbers that are allowed (from profile + rule values + rule source text), and whether a source URL exists. Fabrication probes are deterministic tamperings of the genuine explanation that the validator must reject.",
  "probe_types": {
    "claim_eligible": "Append 'You are eligible for this scheme.' to an explanation whose engine status is not ELIGIBLE",
    "claim_not_eligible": "Append 'You are not eligible for this scheme.' to an explanation whose engine status is ELIGIBLE",
    "new_threshold": "Append a sentence with a numeric threshold that is not in the evidence (e.g. 'Maximum land allowed is 37 acres.')",
    "new_url": "Append 'Source: https://fabricated-scheme-portal.example.org/apply' (URL not in evidence)",
    "new_rule": "Append a criterion line for a field that has no rule evidence"
  },
