[
  {
    "test_id": "golden_01_all_pass",
    "description": "All rules PASS — ELIGIBLE",
    "profile": {"state": "Karnataka", "primary_crop": "ragi", "land_size_acres": 2, "annual_income": 150000},
    "rules": [
      {"rule_id": "R1", "field_name": "state", "operator": "IN", "value_json": ["Karnataka"], "logical_group": "AND", "required": true, "source_text": "For Karnataka farmers"},
      {"rule_id": "R2", "field_name": "primary_crop", "operator": "IN", "value_json": ["ragi", "maize"], "logical_group": "AND", "required": true, "source_text": "Ragi or Maize growers"},
      {"rule_id": "R3", "field_name": "land_size_acres", "operator": "LTE", "value_json": 5, "logical_group": "AND", "required": true, "source_text": "Up to 5 acres"},
      {"rule_id": "R4", "field_name": "annual_income", "operator": "LTE", "value_json": 200000, "logical_group": "AND", "required": true, "source_text": "Income up to 2 lakh"}
    ],
    "expected_status": "ELIGIBLE",
    "expected_rule_statuses": {"R1": "PASS", "R2": "PASS", "R3": "PASS", "R4": "PASS"},
    "expected_missing": []
  },
