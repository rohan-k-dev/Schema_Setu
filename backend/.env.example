# ==============================================================
# SchemeSetu backend — environment configuration (authoritative template)
# ==============================================================
# Copy to backend/.env and fill in values:   cp .env.example .env
# Every variable read by backend/app/core/config.py is listed here.
# Full reference (source, required?, missing behaviour): docs/ENVIRONMENT.md
#
# ALL variables are SERVER-ONLY. None of them is ever sent to the browser.
# The frontend has exactly one public variable: NEXT_PUBLIC_API_BASE_URL (frontend/.env.local).
# Never commit backend/.env (it is git-ignored).
# ==============================================================

# --- Runtime ---------------------------------------------------
# development | staging | production   (demo is set only by scripts/demo_server.py)
ENVIRONMENT=development
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR (production: INFO or WARNING)
BACKEND_HOST=0.0.0.0                # used by `python -m app`
BACKEND_PORT=8000

# --- Database (REQUIRED for scheme search and eligibility rules) ---
# Local Docker:  postgresql://schemesetu:schemesetu@localhost:5432/schemesetu
# Production: a managed PostgreSQL URL with TLS (e.g. ...?sslmode=require)
DATABASE_URL=postgresql://schemesetu:schemesetu@localhost:5432/schemesetu
# Legacy fallback, used only when DATABASE_URL is empty:
# NEON_DATABASE_URL=
DB_MIN_SIZE=1
DB_MAX_SIZE=5

# --- External AI services --------------------------------------
# REQUIRED for real conversations: language understanding (profile extraction),
# query rewriting and reply wording. Without it the assistant keeps asking for
# the profile (use scripts/demo_server.py for a keyless demo).
GROQ_API_KEY=your_groq_api_key_here
# Groq model. Groq retires models over time; if chat stops working, pick another from
# https://console.groq.com/docs/models  (llama-3.3-70b-versatile is no longer offered).
GROQ_MODEL=openai/gpt-oss-20b
# OPTIONAL: live web discovery. Without it: database + knowledge graph only.
TAVILY_API_KEY=your_tavily_api_key_here
# OPTIONAL: speech-to-text, text-to-speech and translation. Without it: English text only,
# voice requests return a clear "not configured" error.
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Timeouts (seconds) ----------------------------------------
GROQ_TIMEOUT=30.0
SARVAM_TIMEOUT=30.0
DB_TIMEOUT=10.0
DB_SEARCH_TIMEOUT=5.0
GRAPH_SEARCH_TIMEOUT=3.0
TAVILY_SEARCH_TIMEOUT=10.0

# Query-time check of official government websites (docs/LIVE_VERIFICATION.md)
LIVE_VERIFICATION_ENABLED=true
LIVE_BUDGET_SECONDS=9.0
LIVE_MAX_SOURCES=8
LIVE_DIRECT_FETCH_SCHEMES=4
LIVE_TAVILY_RESULTS=5
LIVE_FETCH_TIMEOUT=6.0
LIVE_MAX_BYTES=3000000
LIVE_HOST_MIN_INTERVAL=1.0

# --- Retrieval / response limits -------------------------------
MAX_DB_RESULTS=60
MAX_GRAPH_RESULTS=25
MAX_WEB_RESULTS=5
MAX_CANDIDATES=60                  # candidates evaluated by the eligibility engine
MAX_RESPONSE_SCHEMES=60            # ranked schemes returned to the user
RECENT_MESSAGES_WINDOW=10          # conversation turns given to the LLM
# PROFILE_PRIORITY=["state","land_size_acres","primary_crop"]

# --- Request limits --------------------------------------------
MAX_MESSAGE_CHARS=2000
MAX_AUDIO_SIZE_MB=10.0

# --- Sessions (in-memory; oldest evicted beyond this) ----------
# ~300 KB per retained session. Small servers: 200-500.
MAX_SESSIONS=1000

# --- Human review API ------------------------------------------
# Shared reviewer key (X-Review-Key header). Unset = review API disabled (403).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
# REVIEW_API_KEY=

# --- Accounts (sign-in) — see docs/AUTH.md ---------------------
# Sessions are server-side; the browser gets an HttpOnly cookie. All optional.
# SESSION_IDLE_MINUTES=720          # signed out after 12 h without activity
# SESSION_ABSOLUTE_HOURS=168        # signed out 7 days after sign-in
# COOKIE_SECURE=                    # default: true only when ENVIRONMENT=production (needs HTTPS)
# SESSION_SECRET=                   # key for CSRF tokens; unset = random per restart (fine locally)
# REQUIRE_EMAIL_VERIFICATION=true
# PASSWORD_RESET_EXPIRE_MINUTES=30
# EMAIL_VERIFY_EXPIRE_HOURS=24
# LOGIN_MAX_FAILURES=5              # then the account is locked for LOGIN_LOCK_MINUTES
# LOGIN_LOCK_MINUTES=15
# FRONTEND_BASE_URL=http://localhost:3000   # used in e-mail links

# --- Outgoing e-mail (verification / password reset) -----------
# Without SMTP_HOST (local use) e-mails, with their links, are printed in the
# backend log:  docker compose logs backend   (never in production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=SchemeSetu <no-reply@example.com>

# --- CORS ------------------------------------------------------
# JSON list of browser origins allowed to call the API.
# Production: your exact frontend origin(s), never "*".
CORS_ORIGINS=["http://localhost:3000"]

# Chat history (docs/CHAT_HISTORY.md)
# RETENTION_CHAT_DAYS=365
